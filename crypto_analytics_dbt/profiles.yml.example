crypto_analytics_dbt:
  target: dev
  outputs:
    dev:
      type: bigquery
      method: "{{ env_var('BIGQUERY_AUTH_METHOD', 'oauth') }}"
      project: "{{ env_var('GOOGLE_CLOUD_PROJECT') }}"
      dataset: "{{ env_var('BIGQUERY_DATASET') }}"
      keyfile: "{{ env_var('GOOGLE_APPLICATION_CREDENTIALS', '') }}"
      threads: 1
      timeout_seconds: 300
      location: "{{ env_var('BIGQUERY_LOCATION', '') }}"

# Optional: DuckDB local profile for fast local development and CI that does
# not require GCP credentials. To use locally, copy this block into your
# user `~/.dbt/profiles.yml` or edit `crypto_analytics_dbt/profiles.yml` and
# set `target: duck`.
    duck:
      type: duckdb
      # default path points to the repo's main warehouse DuckDB file
      path: "{{ env_var('DUCKDB_DATABASE', 'warehouse/analytics.duckdb') }}"
      threads: 1
      extensions: []
